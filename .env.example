# Copy this file to .env and fill in the values for local development.
# LinkPreview API key used to fetch metadata for link previews.
LINK_PREVIEW_API_KEY=

# BFF is the default BlueBubbles transport and should remain enabled.
BFF_ENABLED=true
# Direct browser auth is deprecated; enable only for emergency fallback/testing.
BFF_DIRECT_MODE_ENABLED=false

# Local dev helper: proxy /bff and /bff/socket from webpack dev-server to the Node BFF.
BFF_DEV_PROXY_ENABLED=true
BFF_PROXY_TARGET=http://127.0.0.1:3100
