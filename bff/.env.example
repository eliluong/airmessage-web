# Required. Set a strong random value in deployment.
BFF_SESSION_SECRET=change-me

# Optional runtime settings
PORT=3100
BFF_COOKIE_SECURE=false
BFF_TRUST_PROXY=false
# Comma-separated list when deploying cross-origin; leave empty for same-origin deployments.
BFF_ALLOWED_ORIGINS=
BFF_SESSION_COOKIE_NAME=bff_session
BFF_SESSION_MAX_AGE_MS=86400000
BFF_SESSION_STORE_MODE=memory
BFF_SESSION_TTL_SECONDS=86400
BFF_REDIS_URL=
BFF_REDIS_KEY_PREFIX=airmessage:bff:sess:
BFF_REQUEST_BODY_LIMIT=256kb

# Upstream host policy (recommended for production)
BFF_UPSTREAM_ALLOWLIST_ENFORCED=false
BFF_UPSTREAM_ALLOWED_HOSTS=
BFF_UPSTREAM_ALLOWED_CIDRS=

# Rate limiting
BFF_RATE_LIMIT_ENABLED=true
BFF_RATE_LIMIT_PROXY_WINDOW_MS=60000
BFF_RATE_LIMIT_PROXY_MAX_REQUESTS=300
BFF_RATE_LIMIT_AUTH_WINDOW_MS=60000
BFF_RATE_LIMIT_AUTH_MAX_REQUESTS=20

# Metrics
BFF_METRICS_ENABLED=true
BFF_METRICS_BEARER_TOKEN=
